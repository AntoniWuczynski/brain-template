# Copy this file to `.env` (which is git-ignored) and fill in your values.
#
# Two unrelated groups of variables live below the divider marked "MCP
# server". Everything ABOVE it is loaded automatically by scripts/ingest.py,
# scripts/ask.py and scripts/pull.py (connectors) via python-dotenv reading
# THIS repo's root `.env`. Everything BELOW it is read by mcp_server/config.py
# directly from the process environment — python-dotenv never touches it —
# and on a deployed server it comes from a SEPARATE `.env` at the service
# directory's root (`~/services/brain/.env`), wired in by the systemd user
# unit's `EnvironmentFile=`. See mcp/DEPLOY.md for the full server deploy.

# ---------------------------------------------------------------------------
# LLM provider for the summarizer + topic tagger
# ---------------------------------------------------------------------------
#
# Pick ONE of: anthropic, openai, gemini, local. If BRAIN_LLM_PROVIDER is
# unset, the summarizer auto-detects from whichever API key below is
# present (anthropic > openai > gemini > local).
#
# If no provider is configured, ingestion still works but the index
# notes show placeholders for Summary, Key points, and Topics.

# BRAIN_LLM_PROVIDER=anthropic

# Optional override for the model name. Defaults per provider:
#   anthropic: claude-haiku-4-5
#   openai:    gpt-5-mini
#   gemini:    gemini-2.5-flash
#   local:     value of BRAIN_LOCAL_MODEL, or llama3.1:8b
# BRAIN_LLM_MODEL=

# Anthropic provider
ANTHROPIC_API_KEY=

# OpenAI provider
# OPENAI_API_KEY=

# Gemini provider (either name works)
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Local provider — any OpenAI-compatible server
# (Ollama, LM Studio, llama.cpp's server, vLLM, etc.)
# BRAIN_LOCAL_URL=http://localhost:11434/v1
# BRAIN_LOCAL_MODEL=llama3.1:8b
# BRAIN_LOCAL_API_KEY=    # only needed if your local server enforces auth

# Skip summarization entirely, even when a provider is configured.
# BRAIN_SKIP_SUMMARY=1

# ---------------------------------------------------------------------------
# MinerU (full PDF extraction with figures, tables, formulas)
# ---------------------------------------------------------------------------

# Override the MinerU inference device. Defaults to mps on Apple
# Silicon, cuda if available, otherwise cpu.
# MINERU_DEVICE_MODE=mps

# Switch model source if Hugging Face is blocked. Default: huggingface.
# MINERU_MODEL_SOURCE=modelscope

# OCR language for scanned PDFs. Default: en. Polish, Spanish and other
# Latin-script languages use `latin` (MinerU has no `pl`/`es` code; an
# unknown value makes every PDF in the run fall back to pypdf as partial).
# BRAIN_MINERU_LANG=latin

# ---------------------------------------------------------------------------
# Semantic search
# ---------------------------------------------------------------------------

# Override the embedding-model device. Same options as MINERU_DEVICE_MODE.
# BRAIN_EMBED_DEVICE=mps

# ---------------------------------------------------------------------------
# Connectors (scripts/pull.py)
# ---------------------------------------------------------------------------

# Granola meeting connector: API token (paid/workspace-gated). Without it
# `pull.py granola` yields nothing.
# GRANOLA_API_KEY=

# justREC meeting connector: the folder justREC exports meetings to (reads
# its *.json exports). Without it `pull.py justrec` yields nothing.
# BRAIN_JUSTREC_DIR=~/Documents/justREC

# Claude Code session-transcript connector: local file read, no API/auth.
# Reads ~/.claude/projects/<slugged-cwd>/*.jsonl by default.
# BRAIN_CLAUDE_CODE_DIR=~/.claude/projects
# How far back to look (days). 0 disables the cutoff.
# BRAIN_CLAUDE_CODE_SINCE_DAYS=14
# Max sessions per pull (newest mtime first). 0 disables the cap.
# BRAIN_CLAUDE_CODE_MAX_SESSIONS=50
# A session touched more recently than this (hours) is skipped — excludes
# the session doing the pulling, and lets a multi-day session settle into
# ONE snapshot instead of being re-snapshotted whole on every pull.
# BRAIN_CLAUDE_CODE_SETTLE_HOURS=24

# claude.ai / ChatGPT conversation-export connector: point at a downloaded
# `conversations.json` (either service's "Export data"). No API, no auth.
# Without it (and without BRAIN_PULL_PATH / --path) `pull.py chat_export`
# yields nothing.
# BRAIN_CHAT_EXPORT_PATH=~/Downloads/conversations.json
# Max conversations per pull (newest first). 0 disables the cap.
# BRAIN_CHAT_EXPORT_MAX=50

# Generic source override for a local-file connector — set by
# `pull.py <connector> --path <file>` for that one run; wins over the
# connector-specific env var above (e.g. BRAIN_CHAT_EXPORT_PATH) when both
# are set. Not normally set directly in .env.
# BRAIN_PULL_PATH=

# Shared by both transcript connectors: total-character budget per
# session/conversation, on top of the ~6,000-char per-turn cap — keeps the
# newest turns and drops the rest (recorded in the note's processing notes)
# so one long-running session can't produce a megabyte-plus snapshot.
# BRAIN_TRANSCRIPT_MAX_CHARS=60000

# ---------------------------------------------------------------------------
# Audio transcription (extractors/audio.py)
# ---------------------------------------------------------------------------

# Whisper model for audio files. Needs `faster-whisper` installed (it bundles
# audio decoding via PyAV); without it, audio is marked manual_review.
# tiny|base|small|medium|large.
# BRAIN_WHISPER_MODEL=base

# ---------------------------------------------------------------------------
# Retrieval (opt-in, changes passage vectors — needs --rebuild-search-index)
# ---------------------------------------------------------------------------

# Embed each chunk with its `{title} > {heading_path}` prefix for section
# context. Off by default; A/B with eval_retrieval.py --compare-modes.
# BRAIN_EMBED_HEADING_CONTEXT=1

# ===========================================================================
# MCP server (mcp_server/) — read directly from the environment by
# mcp_server/config.py, NOT via python-dotenv. Everything from here down is
# the template for a DEPLOYED server's own `.env` (see mcp/DEPLOY.md); it is
# irrelevant to `scripts/ingest.py` and friends above.
# ===========================================================================

# Absolute path to the brain repo checkout this server serves — the deployed
# server's own clone, e.g. /home/<you>/services/brain (systemd's `%h` in the
# unit file expands to this at start).
BRAIN_MCP_VAULT_ROOT=

# Per-client tokens: name=token pairs, comma separated. Each name becomes
# the `mcp(<name>): ...` commit author and the identity in
# logs/mcp-{audit,access}.jsonl. Names: lowercase slug, max 32 chars; tokens:
# min 24 chars, no '=' or ','. Generate with: openssl rand -hex 32
BRAIN_MCP_TOKENS=claude-code=REPLACE_ME,codex=REPLACE_ME

# Bind loopback-only; reach it over Tailscale or a tunnel, never 0.0.0.0
# directly — see mcp/DEPLOY.md.
BRAIN_MCP_BIND_HOST=127.0.0.1
BRAIN_MCP_BIND_PORT=8765

# DNS-rebind guard (TrustedHostMiddleware). Loopback is always allowed;
# every other Host value the server will be reached by — the tailnet
# hostname, a tunnel hostname — must be listed here or the request is
# rejected before it reaches any handler.
BRAIN_MCP_ALLOWED_HOSTS=

# Push writes back to origin/main so other clones (e.g. the Mac's Obsidian
# working clone) see them on `git pull`. Must equal the branch actually
# checked out at BRAIN_MCP_VAULT_ROOT.
BRAIN_MCP_GIT_PUSH_ON_WRITE=1
BRAIN_MCP_GIT_REMOTE=origin
BRAIN_MCP_GIT_BRANCH=main

# SSH key for git push. Kept OUTSIDE BRAIN_MCP_VAULT_ROOT (e.g. under
# ~/.ssh, never inside the service dir) so a compromised agent can never
# reach it through the read tools — see mcp/DEPLOY.md.
# GIT_SSH_COMMAND=ssh -i /home/<you>/.ssh/brain-mcp-deploy -o IdentitiesOnly=yes -o UserKnownHostsFile=/home/<you>/.ssh/known_hosts -o StrictHostKeyChecking=yes

# warning | info | debug
BRAIN_MCP_LOG_LEVEL=info

# Per IMP-028/AUD-124 the server never runs MinerU, faster-whisper or the
# vision extractors — ingestion stays on the Mac. It DOES install a CPU
# torch + sentence-transformers by default (mcp/DEPLOY.md step 1) so
# memory_search/vault_search get real hybrid (dense+lexical) search;
# lexical-only BM25 is the documented downgrade for a box that skips that
# install. The unit file (mcp/DEPLOY.md step 4) sets HF_HOME under the
# service dir unconditionally — uncomment this only for a non-systemd run:
# HF_HOME=/home/<you>/services/brain/.cache/huggingface
