filters:
  and:
    - file.ext == "md"
    - file.folder.endsWith("/decisions")
    - or:
        - file.inFolder("knowledge/projects")
        - file.inFolder("knowledge/chats")
properties:
  number:
    displayName: No.
  decided:
    displayName: Decided
views:
  - type: table
    name: By status
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - project
      - number
      - title
      - status
      - decided
  - type: table
    name: Proposed
    filters: status == "proposed"
    order:
      - file.name
      - project
      - number
      - title
      - date
