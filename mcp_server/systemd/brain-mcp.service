[Unit]
Description=brain MCP server
Documentation=https://github.com/AntoniWuczynski/brain-template/blob/main/mcp/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User systemd unit: no User=/Group= (the user manager already runs as the
# invoking user; a system-manager directive here is refused at load time).
# Install to ~/.config/systemd/user/ and run with `systemctl --user`. %h
# expands to the invoking user's home directory.
WorkingDirectory=%h/services/brain
EnvironmentFile=%h/services/brain/.env

# Run the venv interpreter directly (built by `uv sync` -> %h/services/brain/.venv).
# Avoids depending on uv's location on PATH at service-start time.
ExecStart=%h/services/brain/.venv/bin/python -m mcp_server

# Keep model/cache downloads under the writable service dir rather than the
# default ~/.cache the process would otherwise use, so a stray HOME can't
# send the sentence-transformers weight download (when that stack is
# installed — see mcp/DEPLOY.md "no ML stack") somewhere unexpected.
Environment=HF_HOME=%h/services/brain/.cache/huggingface
Environment=XDG_CACHE_HOME=%h/services/brain/.cache

Restart=on-failure
RestartSec=5

# --- hardening: deny everything this service doesn't need ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only, not true: git push reads the deploy key under ~/.ssh (kept
# OUTSIDE %h/services/brain — see DEPLOY.md — so a compromised agent can't
# reach it through the read tools), which "true" would hide entirely.
ProtectHome=read-only
# The service dir is the only path this unit writes to; everything else
# under $HOME stays read-only per ProtectHome above.
ReadWritePaths=%h/services/brain
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
# NOTE: no MemoryDenyWriteExecute — torch / sentence-transformers (when
# installed) map executable pages (JIT, BLAS) and vault_search would break.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
CapabilityBoundingSet=
AmbientCapabilities=
# Network — only outbound to GitHub for push and the tailnet/tunnel for
# inbound. (No fine-grained outbound restriction here; rely on the host's
# firewall if you want one.)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=default.target
