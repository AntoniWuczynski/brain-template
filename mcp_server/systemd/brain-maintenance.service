[Unit]
Description=brain vault maintenance (consolidate + sweep)
Documentation=https://github.com/AntoniWuczynski/brain-template/blob/main/scripts/README.md
# Best-effort: prefer running when the MCP server is up but idle. There is no
# cross-process write lock, so keep the timer at a quiet hour (see the .timer).
After=network-online.target

[Service]
Type=oneshot
# User systemd unit: no User=/Group= (the user manager already runs as the
# invoking user). Install to ~/.config/systemd/user/. %h expands to the
# invoking user's home directory.
WorkingDirectory=%h/services/brain
EnvironmentFile=%h/services/brain/.env
Environment=HF_HOME=%h/services/brain/.cache/huggingface
Environment=XDG_CACHE_HOME=%h/services/brain/.cache
# maintain.sh repairs its own PATH (uv, and the .venv fallback) and resolves
# the repo root from its own location, so no further ExecStart plumbing is
# needed here.
ExecStart=/bin/bash %h/services/brain/scripts/maintain.sh

# Deliberately NOT filesystem-sandboxed like brain-mcp.service: maintain.sh
# shells out to `uv` (which may live anywhere under $HOME — ~/.local/bin,
# ~/.cargo/bin, a pyenv/asdf shim) and this job's actual footprint has never
# been characterised the way the always-on server's has. Add ProtectSystem=
# strict / ProtectHome= here only after confirming the run's full file
# access under a real systemd instance — getting it wrong fails the
# scheduled job silently until someone reads journalctl.
