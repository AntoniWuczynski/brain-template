# Fast-forward the server's clone to the remote, so what other machines push
# (Obsidian edits, a laptop ingest) is readable here without waiting for the
# next MCP write's pull-before-write. Pull-only: the MCP server's push worker
# owns this clone's commits; see scripts/vault_sync.sh. Also restarts
# brain-mcp when server code changed, since a pull does not reload it.
#
# .env supplies BRAIN_MCP_GIT_REMOTE/BRANCH and GIT_SSH_COMMAND (deploy key).
[Unit]
Description=brain vault sync (fast-forward from remote)
Documentation=https://github.com/AntoniWuczynski/brain-template/blob/main/scripts/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/services/brain
EnvironmentFile=-%h/services/brain/.env
ExecStart=/bin/bash %h/services/brain/scripts/vault_sync.sh --pull-only
